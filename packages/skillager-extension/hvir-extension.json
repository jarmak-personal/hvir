{
  "id": "skillager",
  "name": "Skillager",
  "version": "0.3.0",
  "contract": "1.0",
  "landing": "library",
  "requiredCapabilities": [
    "presentation.read",
    "context.read",
    "viewer.open-own",
    "connector.status",
    "connector.execute",
    "connector.output",
    "source.status",
    "source.request",
    "source.select",
    "source.read",
    "source.asset",
    "source.render",
    "source.reveal",
    "source.request-trash",
    "actions.invoke",
    "terminal.start",
    "delivery.capture",
    "delivery.manifest",
    "delivery.preview",
    "delivery.apply",
    "delivery.status",
    "delivery.domain",
    "delivery.reconcile",
    "delivery.cleanup"
  ],
  "optionalCapabilities": ["connector.connect"],
  "access": [
    {
      "id": "library",
      "description": "Read selected instruction files and images in your personal library",
      "context": "application",
      "mode": "read-only"
    },
    {
      "id": "project",
      "description": "Read selected instruction files and images in the exact registered project or worktree",
      "context": "workspace",
      "mode": "read-only"
    },
    {
      "id": "delivery-source",
      "description": "Use approved Full copies from the local export folder you choose",
      "context": "application",
      "mode": "delivery-source"
    },
    {
      "id": "delivery-target",
      "description": "Add, update or remove managed Full skill copies in the exact selected SSH project or worktree, preserving prior copies",
      "context": "workspace",
      "mode": "managed-delivery"
    }
  ],
  "views": [
    {
      "id": "library",
      "title": "Skillager library",
      "entry": "library.html",
      "placement": "application",
      "navigation": "top",
      "representations": ["view"]
    },
    {
      "id": "project",
      "title": "Skills in this project",
      "entry": "project.html",
      "placement": "workspace",
      "navigation": "left",
      "representations": ["view"],
      "navigationIcon": "skillager.svg"
    },
    {
      "id": "detail",
      "title": "Skill instructions",
      "entry": "detail.html",
      "placement": "application",
      "representations": ["view"]
    },
    {
      "id": "management",
      "title": "Manage skills",
      "entry": "management.html",
      "placement": "application",
      "representations": ["view"]
    }
  ],
  "actions": [
    {
      "id": "initialize-library",
      "title": "Create personal library",
      "view": "management",
      "agents": true,
      "effects": {
        "delete": false,
        "replace": false
      },
      "description": "Create using Skillager defaults or an explicit custom local location; preserve an existing registration and verify public status before connecting.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "location": {
            "type": "string",
            "enum": ["default", "custom"]
          },
          "root": {
            "type": "object",
            "properties": {
              "hostId": {
                "type": "string",
                "enum": ["local"]
              },
              "path": {
                "type": "string",
                "maxLength": 2048
              }
            },
            "required": ["hostId", "path"],
            "additionalProperties": false
          },
          "git": {
            "type": "boolean"
          }
        },
        "required": ["location"],
        "additionalProperties": false
      }
    },
    {
      "id": "sync-library",
      "title": "Sync approved sources into personal library",
      "view": "management",
      "agents": true,
      "effects": {
        "delete": true,
        "replace": true
      },
      "description": "Sync approved sources with complete effect/recovery details and no-effect counts. A local workspace uses independently approved project-cli and project discovery; no target uses library-cli. SSH is refused. Connect the selected context first.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "library": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 80
              },
              "root": {
                "type": "object",
                "properties": {
                  "hostId": {
                    "type": "string",
                    "enum": ["local"]
                  },
                  "path": {
                    "type": "string",
                    "maxLength": 2048
                  }
                },
                "required": ["hostId", "path"],
                "additionalProperties": false
              },
              "gitMode": {
                "type": "string",
                "enum": ["system", "disabled"]
              }
            },
            "required": ["id", "root"],
            "additionalProperties": false
          },
          "reviewHash": {
            "type": "string",
            "maxLength": 64
          }
        },
        "required": ["library"],
        "additionalProperties": false
      }
    },
    {
      "id": "add-copy",
      "title": "Add selected Full or Stub copy",
      "view": "management",
      "agents": true,
      "effects": {
        "delete": false,
        "replace": false
      },
      "description": "Add local Full/Stub or approved local-library Full to the exact SSH workspace; SSH requires an explicit missing/empty local export directory. No remote CLI or overwrite.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "library": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 80
              },
              "root": {
                "type": "object",
                "properties": {
                  "hostId": {
                    "type": "string",
                    "enum": ["local"]
                  },
                  "path": {
                    "type": "string",
                    "maxLength": 2048
                  }
                },
                "required": ["hostId", "path"],
                "additionalProperties": false
              },
              "gitMode": {
                "type": "string",
                "enum": ["system", "disabled"]
              }
            },
            "required": ["id", "root"],
            "additionalProperties": false
          },
          "skillId": {
            "type": "string",
            "maxLength": 256
          },
          "hash": {
            "type": "string",
            "maxLength": 64
          },
          "agent": {
            "type": "string",
            "enum": ["codex", "claude"]
          },
          "mode": {
            "type": "string",
            "enum": ["native", "stub"]
          },
          "exportDirectory": {
            "type": "string",
            "maxLength": 2048
          }
        },
        "required": ["library", "skillId", "hash", "agent", "mode"],
        "additionalProperties": false
      }
    },
    {
      "id": "change-exposure",
      "title": "Change selected project exposure",
      "view": "management",
      "agents": true,
      "effects": {
        "delete": true,
        "replace": true
      },
      "description": "Review and apply one exact local Update, Router grouping, complete membership change, Ungroup or preserved native adoption through a whole public token-bound plan. No force or replay. SSH supports Full Update with exact opaque managed record, target, source hash and export directory.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "library": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 80
              },
              "root": {
                "type": "object",
                "properties": {
                  "hostId": {
                    "type": "string",
                    "enum": ["local"]
                  },
                  "path": {
                    "type": "string",
                    "maxLength": 2048
                  }
                },
                "required": ["hostId", "path"],
                "additionalProperties": false
              },
              "gitMode": {
                "type": "string",
                "enum": ["system", "disabled"]
              }
            },
            "required": ["id", "root"],
            "additionalProperties": false
          },
          "agent": {
            "type": "string",
            "enum": ["codex", "claude"]
          },
          "request": {
            "type": "string",
            "maxLength": 6144
          },
          "token": {
            "type": "string",
            "maxLength": 64
          }
        },
        "required": ["library", "agent", "request"],
        "additionalProperties": false
      }
    },
    {
      "id": "remove-copy",
      "title": "Remove selected managed copy",
      "view": "management",
      "agents": true,
      "effects": {
        "delete": true,
        "replace": false
      },
      "description": "Preserve the selected unchanged local managed copy or exact core-recorded SSH Full. SSH uses record, skillId, mode native and the exact target; local removal uses the public token.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "library": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 80
              },
              "root": {
                "type": "object",
                "properties": {
                  "hostId": {
                    "type": "string",
                    "enum": ["local"]
                  },
                  "path": {
                    "type": "string",
                    "maxLength": 2048
                  }
                },
                "required": ["hostId", "path"],
                "additionalProperties": false
              },
              "gitMode": {
                "type": "string",
                "enum": ["system", "disabled"]
              }
            },
            "required": ["id", "root"],
            "additionalProperties": false
          },
          "agent": {
            "type": "string",
            "enum": ["codex", "claude"]
          },
          "exposureId": {
            "type": "string",
            "maxLength": 256
          },
          "target": {
            "type": "object",
            "properties": {
              "hostId": {
                "type": "string",
                "maxLength": 256
              },
              "path": {
                "type": "string",
                "maxLength": 2048
              }
            },
            "required": ["hostId", "path"],
            "additionalProperties": false
          },
          "token": {
            "type": "string",
            "maxLength": 64
          },
          "skillId": {
            "type": "string",
            "maxLength": 256
          },
          "hash": {
            "type": "string",
            "maxLength": 64
          },
          "record": {
            "type": "string",
            "maxLength": 80
          },
          "mode": {
            "type": "string",
            "enum": ["native"]
          }
        },
        "required": ["library", "agent", "target"],
        "additionalProperties": false
      }
    },
    {
      "id": "setup-project",
      "title": "Open Skillager setup in a new terminal",
      "view": "management",
      "agents": true,
      "effects": {
        "delete": false,
        "replace": false
      },
      "description": "Explicit setup --agent for the displayed Codex/Claude agent in a new terminal in the exact local workspace, followed by an ordinary shell. No library readiness prerequisite, existing PTY input or recovery replay.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "agent": {
            "type": "string",
            "enum": ["codex", "claude"]
          }
        },
        "required": ["agent"],
        "additionalProperties": false
      }
    },
    {
      "id": "operation-state",
      "title": "Observe and reconcile scoped operation state",
      "view": "management",
      "agents": true,
      "effects": {
        "delete": false,
        "replace": false
      },
      "description": "Metadata-only pending IDs, complete finite report pages, fresh supported safe-repeat observations and explicit acknowledgment by the originally admitted caller class/destination. Original completion stays unknown; no stored decision is replayed.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "list",
              "report",
              "observe",
              "acknowledge",
              "delivery-status",
              "delivery-reconcile",
              "delivery-forget"
            ]
          },
          "operationId": {
            "type": "string",
            "maxLength": 80
          },
          "offset": {
            "type": "number"
          },
          "observation": {
            "type": "string",
            "maxLength": 6144
          }
        },
        "required": ["mode"],
        "additionalProperties": false
      }
    },
    {
      "id": "accept-version",
      "title": "Accept exact human-reviewed library version",
      "view": "management",
      "agents": false,
      "effects": {
        "delete": false,
        "replace": false
      },
      "description": "Accept only the complete exact manifest/token version explicitly reviewed in an ordinary human D7 view. The action revalidates public identity/token, obtains no bodies, supplies no override or force flags, and preserves Skillager Git/scanner/lint authority.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "library": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 80
              },
              "root": {
                "type": "object",
                "properties": {
                  "hostId": {
                    "type": "string",
                    "enum": ["local"]
                  },
                  "path": {
                    "type": "string",
                    "maxLength": 2048
                  }
                },
                "required": ["hostId", "path"],
                "additionalProperties": false
              },
              "gitMode": {
                "type": "string",
                "enum": ["system", "disabled"]
              }
            },
            "required": ["id", "root"],
            "additionalProperties": false
          },
          "skillId": {
            "type": "string",
            "maxLength": 256
          },
          "hash": {
            "type": "string",
            "maxLength": 64
          },
          "token": {
            "type": "string",
            "maxLength": 64
          }
        },
        "required": ["library", "skillId", "hash", "token"],
        "additionalProperties": false
      }
    },
    {
      "id": "save-and-accept",
      "title": "Save and accept selected original",
      "view": "management",
      "agents": false,
      "effects": {
        "delete": false,
        "replace": false
      },
      "description": "Human-only: save one exact external source occurrence into the personal library and accept its complete manifest/token version. Preserves the project original; shows any default-library initialization effect.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "skillId": {
            "type": "string",
            "maxLength": 256
          },
          "file": {
            "type": "object",
            "properties": {
              "hostId": {
                "type": "string",
                "enum": ["local"]
              },
              "path": {
                "type": "string",
                "maxLength": 2048
              }
            },
            "required": ["hostId", "path"],
            "additionalProperties": false
          },
          "name": {
            "type": "string",
            "maxLength": 256
          },
          "hash": {
            "type": "string",
            "maxLength": 64
          },
          "token": {
            "type": "string",
            "maxLength": 64
          }
        },
        "required": ["skillId", "file", "name", "hash", "token"],
        "additionalProperties": false
      }
    },
    {
      "id": "save-and-use-copy",
      "title": "Save and use selected original",
      "view": "management",
      "agents": false,
      "effects": {
        "delete": true,
        "replace": true
      },
      "description": "Human-only: one complete public decision saves and accepts the exact native original, initializes or reconnects the library if needed, and replaces the original with Full or Stub. Separate save and replacement outcomes remain visible; no source approval or automatic retry.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "skillId": {
            "type": "string",
            "maxLength": 256
          },
          "file": {
            "type": "object",
            "properties": {
              "hostId": {
                "type": "string",
                "enum": ["local"]
              },
              "path": {
                "type": "string",
                "maxLength": 2048
              }
            },
            "required": ["hostId", "path"],
            "additionalProperties": false
          },
          "name": {
            "type": "string",
            "maxLength": 256
          },
          "hash": {
            "type": "string",
            "maxLength": 64
          },
          "token": {
            "type": "string",
            "maxLength": 64
          },
          "agent": {
            "type": "string",
            "enum": ["codex", "claude"]
          },
          "mode": {
            "type": "string",
            "enum": ["native", "stub"]
          }
        },
        "required": ["skillId", "file", "name", "hash", "token", "agent", "mode"],
        "additionalProperties": false
      }
    },
    {
      "id": "save-project-skills",
      "title": "Save project skills to library",
      "view": "management",
      "agents": false,
      "effects": {
        "delete": false,
        "replace": false
      },
      "description": "Human-only: save and accept the exact selected local project originals through one complete public batch review. Original files and source approvals stay unchanged. No overwrite or automatic retry.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "selection": {
            "type": "string",
            "maxLength": 4096
          },
          "token": {
            "type": "string",
            "maxLength": 64
          }
        },
        "required": ["selection", "token"],
        "additionalProperties": false
      }
    }
  ],
  "connectors": [
    {
      "id": "library-cli",
      "description": "Browse and manage your personal skills library.",
      "context": "application",
      "setup": {
        "executable": "skillager"
      },
      "timeoutMs": 180000,
      "outputBytes": 4194304,
      "environment": ["SKILLAGER_CATALOG_STATE_DIR", "XDG_CACHE_HOME", "XDG_STATE_HOME"]
    },
    {
      "id": "project-cli",
      "description": "Use the Skillager CLI you approve in the exact registered local project or worktree",
      "context": "workspace",
      "timeoutMs": 180000,
      "outputBytes": 4194304,
      "environment": ["SKILLAGER_CATALOG_STATE_DIR", "XDG_CACHE_HOME", "XDG_STATE_HOME"],
      "setup": {
        "executable": "skillager"
      }
    }
  ]
}
